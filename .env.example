# Copia este archivo como .env y llena los valores de tu proyecto de Firebase
# (Consola de Firebase → Configuración del proyecto → Tus apps → Web).

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Para desarrollo local con los emuladores de Firebase (no necesita proyecto real):
# EXPO_PUBLIC_USE_EMULATORS=true
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-teayudo
# IP de tu computador en la red (el celular debe estar en el mismo wifi).
# En el emulador de Android usa 10.0.2.2; en el simulador de iOS, localhost.
# EXPO_PUBLIC_EMULATOR_HOST=192.168.1.50
